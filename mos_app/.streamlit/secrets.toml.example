# Copy to .streamlit/secrets.toml for local testing (gitignored), or paste into
# Streamlit Community Cloud's app settings -> Secrets when deploying.
#
# GITHUB_TOKEN: a fine-grained GitHub Personal Access Token, scoped to ONLY this repo
# (shakirul360/AvatarVerse), with "Contents: Read and write" permission and nothing else.
# Create at github.com/settings/personal-access-tokens/new -> "Only select repositories" ->
# AvatarVerse -> Repository permissions -> Contents -> Read and write.
#
# Without this secret, the app falls back to writing local_responses.csv next to app.py -
# fine for local testing, but responses won't persist once deployed (Streamlit Cloud's
# filesystem is ephemeral).
GITHUB_TOKEN = "github_pat_..."
